DB_DRIVER=postgres
DB_USERNAME=CHANGE_ME_DB_USERNAME
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# One PostgreSQL instance + PgBouncer per bounded context (session pool).
# The seeder targets PgBouncer on port 5432 in the local compose network:
#   identity     -> ec_identity   (pgbouncer_identity:5432)
#   merchant     -> ec_merchant   (pgbouncer_merchant:5432)
#   catalog      -> ec_catalog    (pgbouncer_catalog:5432)
#   sales        -> ec_sales      (pgbouncer_sales:5432)
#   experience   -> ec_experience (pgbouncer_experience:5432)
#   email        -> ec_email      (pgbouncer_email:5432)
# Username/password fall back to the shared DB_* keys above; there is no
# generic DB_HOST/DB_PORT/DB_NAME.
DB_MAX_OPEN_CONNS=10
DB_MIN_IDLE_CONNS=2
DB_CONN_MAX_LIFETIME=30m

DB_SEEDER=true

SECRET_KEY=CHANGE_ME_SECRET_KEY

DB_IDENTITY_HOST=pgbouncer_identity
DB_IDENTITY_PORT=5432
DB_IDENTITY_NAME=ec_identity
DB_MERCHANT_HOST=pgbouncer_merchant
DB_MERCHANT_PORT=5432
DB_MERCHANT_NAME=ec_merchant
DB_CATALOG_HOST=pgbouncer_catalog
DB_CATALOG_PORT=5432
DB_CATALOG_NAME=ec_catalog
DB_SALES_HOST=pgbouncer_sales
DB_SALES_PORT=5432
DB_SALES_NAME=ec_sales
DB_EXPERIENCE_HOST=pgbouncer_experience
DB_EXPERIENCE_PORT=5432
DB_EXPERIENCE_NAME=ec_experience
DB_EMAIL_HOST=pgbouncer_email
DB_EMAIL_PORT=5432
DB_EMAIL_NAME=ec_email

KAFKA_BROKERS=localhost:9092

GRPC_AUTH_ADDR=50051
GRPC_ROLE_ADDR=50052
GRPC_USER_ADDR=50053
GRPC_CATEGORY_ADDR=50054
GRPC_MERCHANT_ADDR=50055
GRPC_ORDER_ITEM_ADDR=50056
GRPC_ORDER_ADDR=50057
GRPC_PRODUCT_ADDR=50058
GRPC_TRANSACTION_ADDR=50059
GRPC_CART_ADDR=50060
GRPC_REVIEW_ADDR=50061
GRPC_SLIDER_ADDR=50062
GRPC_SHIPPING_ADDRESS_ADDR=50063
GRPC_BANNER_ADDR=50064
GRPC_MERCHANT_AWARD_ADDR=50065
GRPC_MERCHANT_BUSINESS_ADDR=50066
GRPC_MERCHANT_DETAIL_ADDR=50067
GRPC_MERCHANT_POLICY_ADDR=50068
GRPC_REVIEW_DETAIL_ADDR=50069


REDIS_DB_AUTH=0
REDIS_DB_ROLE=1
REDIS_DB_USER=2
REDIS_DB_CATEGORY=3
REDIS_DB_MERCHANT=4
REDIS_DB_ORDER_ITEM=5
REDIS_DB_ORDER=6
REDIS_DB_PRODUCT=7
REDIS_DB_TRANSACTION=8
REDIS_DB_CART=9
REDIS_DB_REVIEW=10
REDIS_DB_SLIDER=11
REDIS_DB_SHIPPING_ADDRESS=12
REDIS_DB_BANNER=13
REDIS_DB_MERCHANT_AWARD=14
REDIS_DB_MERCHANT_BUSINESS=15
REDIS_DB_MERCHANT_DETAIL=16
REDIS_DB_MERCHANT_POLICY=17
REDIS_DB_REVIEW_DETAIL=18




